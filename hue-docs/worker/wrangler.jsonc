{
  // Docs v2: the frozen site as static assets, and a Python Worker that runs
  // only the demo routes. run_worker_first sends /demos/ to the Worker and
  // everything else straight to the files, which costs no Worker CPU.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "hue-docs-v2",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  // Only .py files are bundled by default; hue reads its icons from disk.
  "rules": [{ "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }],
  "assets": {
    "directory": "../dist-v2",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/demos/*"]
  }
}
