# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
node_modules/

# Claude Code — machine-local settings (committed config lives in settings.json)
.claude/settings.local.json

# Built by `make build-css` in hue-python. Generated, so not committed - see
# hue-python/README or CLAUDE.md.
hue-python/src/hue/static/styles/tailwind.css

# The design guide is version-controlled as the zip beside it; the extracted
# folder is a local working copy.
Hue-Component-Library-Design-System/

.DS_Store

# A page for trying TableOfContents by hand, and the script that writes it.
# Local toys rather than part of the docs; see the docstring in toc-demo.py.
toc-demo.html
toc-demo.py

# The example app's database, made and seeded by `make serve`.
examples/django/db.sqlite3

# The frozen docs site, and the highlight cache Shiki fills at build time.
# Both generated, for the same reason tailwind.css is not committed.
hue-docs/dist/
hue-docs/.cache/
# Copied into the docs Worker by `make worker`; the sources live beside it.
hue-docs/worker/src/hue/
hue-docs/worker/src/hue_fastapi/
hue-docs/worker/src/hue_docs/
hue-docs/worker/.venv/
hue-docs/worker/python_modules/
hue-docs/worker/.wrangler/
